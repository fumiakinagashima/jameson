{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jameson",
	"compatibility_date": "2026-10-27",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jameson",
			"database_id": "36cc981c-8bd1-4556-856d-eeba6664b3b5",
			"migrations_dir": "drizzle"
		}
	]
}